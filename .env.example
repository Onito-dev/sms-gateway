# Central OTP & SMS Gateway
# Copy to .env and replace every placeholder before running outside local development.
#
# DEPLOYING (Coolify / Docker / PaaS): the four REQUIRED variables are
# DATABASE_URL, REDIS_URL, MASTER_KEY, ADMIN_TOKEN — `npm start` refuses to boot
# without them and names exactly what is missing. In containers use service
# hostnames (e.g. postgres:5432 / redis:6379), NOT localhost.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://gateway:gateway_password@localhost:5432/otp_gateway?schema=public
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate with: openssl rand -base64 48
MASTER_KEY=replace-with-at-least-32-random-characters
# At least 16 random characters. Used for the admin API bearer token.
ADMIN_TOKEN=replace-with-a-long-admin-token
CORS_ORIGINS=http://localhost:5173

OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEFAULT_OTP_MESSAGE=Your verification code is: {{code}}

RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_APP_PER_MINUTE=100
RATE_LIMIT_PHONE_PER_10_MINUTES=3

MAX_PROVIDER_FAILOVER=2
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=600
DEFAULT_COUNTRY=IR

# Optional demo seed values. If empty, the seed creates a random credential.
SEED_DEMO_APP_NAME=Demo Application
SEED_DEMO_APP_SLUG=demo-application
