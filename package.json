{
  "name": "central-otp-sms-gateway",
  "private": true,
  "version": "1.0.0",
  "description": "Central OTP & SMS Gateway — multi-tenant OTP generation, verification and SMS provider management",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:client": "npm run build --workspace packages/otp-client",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
